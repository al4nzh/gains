ENV=development
PORT=8080
DATABASE_URL=postgres://gains:gains@localhost:5432/gains?sslmode=disable

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_at_least_32_random_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# OAuth — must match mobile dart-define client IDs (see mobile/README.md)
# Google: use Web client ID here; also create Android + iOS clients in Google Cloud
GOOGLE_OAUTH_CLIENT_IDS=
# Apple: bundle ID com.alanz.gains (or your Services ID)
APPLE_OAUTH_CLIENT_ID=

# Email — production: use Resend (recommended) OR SMTP (SendGrid, etc.)
# Dev: leave both empty; codes log to API console
RESEND_API_KEY=
# EMAIL_FROM=Gains <noreply@yourdomain.com>
# SendGrid SMTP alternative:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
APP_NAME=Gains
APP_DEEP_LINK_BASE=gains://auth

AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10

PROFILE_RATE_LIMIT_RPS=10
PROFILE_RATE_LIMIT_BURST=20

EXERCISE_RATE_LIMIT_RPS=20
EXERCISE_RATE_LIMIT_BURST=40

ROUTINE_RATE_LIMIT_RPS=15
ROUTINE_RATE_LIMIT_BURST=30

WORKOUT_RATE_LIMIT_RPS=25
WORKOUT_RATE_LIMIT_BURST=50

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_RATE_LIMIT_RPS=3
AI_RATE_LIMIT_BURST=6

# Legacy flag (unused for gating): premium AI features always require is_premium=true.
AI_REQUIRE_PREMIUM=false

# RevenueCat webhook (POST /webhooks/revenuecat) — sets users.is_premium from store events.
# Authorization header must match this secret (RevenueCat dashboard → Webhooks).
REVENUECAT_WEBHOOK_SECRET=
# Secret API key (sk_...) — server-only; enables POST /subscription/sync after login/restore.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

# Daily limits per user (premium tier — abuse protection, not free-tier caps).
AI_DAILY_COACH_MESSAGES=200
AI_DAILY_WORKOUT_ANALYSES=50
AI_DAILY_ROUTINE_GENS=30
AI_DAILY_PHYSIQUE_SCANS=20

PHYSIQUE_RATE_LIMIT_RPS=2
PHYSIQUE_RATE_LIMIT_BURST=4
PHYSIQUE_SCAN_MODEL=gpt-4o-mini
