ENV=development
PORT=8080
DATABASE_URL=postgres://gains:gains@localhost:5432/gains?sslmode=disable

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_at_least_32_random_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10

PROFILE_RATE_LIMIT_RPS=10
PROFILE_RATE_LIMIT_BURST=20

EXERCISE_RATE_LIMIT_RPS=20
EXERCISE_RATE_LIMIT_BURST=40

ROUTINE_RATE_LIMIT_RPS=15
ROUTINE_RATE_LIMIT_BURST=30

WORKOUT_RATE_LIMIT_RPS=25
WORKOUT_RATE_LIMIT_BURST=50
