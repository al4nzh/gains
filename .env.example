ENV=development
PORT=8080
DATABASE_URL=postgres://gains:gains@localhost:5432/gains?sslmode=disable

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_at_least_32_random_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# OAuth — must match mobile dart-define client IDs (see mobile/README.md)
# Google: use Web client ID here; also create Android + iOS clients in Google Cloud
GOOGLE_OAUTH_CLIENT_IDS=
# Apple: bundle ID com.alanz.gains (or your Services ID)
APPLE_OAUTH_CLIENT_ID=

# Email — production: use Resend (recommended) OR SMTP (SendGrid, etc.)
# Dev: leave both empty; codes log to API console
RESEND_API_KEY=
# EMAIL_FROM=Gains <noreply@yourdomain.com>
# SendGrid SMTP alternative:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
APP_NAME=Gains
APP_DEEP_LINK_BASE=gains://auth

AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10

PROFILE_RATE_LIMIT_RPS=10
PROFILE_RATE_LIMIT_BURST=20

EXERCISE_RATE_LIMIT_RPS=20
EXERCISE_RATE_LIMIT_BURST=40

ROUTINE_RATE_LIMIT_RPS=15
ROUTINE_RATE_LIMIT_BURST=30

WORKOUT_RATE_LIMIT_RPS=25
WORKOUT_RATE_LIMIT_BURST=50
