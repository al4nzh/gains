# Copy to your host as production secrets — NEVER commit real values.

ENV=production
PORT=8080

# Postgres (managed provider — require TLS)
DATABASE_URL=postgres://user:pass@host:5432/gains?sslmode=require

# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# OAuth
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_ID=com.alanz.gains

# Email — Resend recommended (https://resend.com)
RESEND_API_KEY=re_
EMAIL_FROM=Gains <noreply@yourdomain.com>
APP_NAME=Gains

# Or SendGrid SMTP instead of Resend:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxx
# EMAIL_FROM=Gains <noreply@yourdomain.com>

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Exercise GIFs — RapidAPI (subscribe: edb-with-gifs-and-images-by-ascendapi)
RAPIDAPI_KEY=
# Optional — image stream uses exercisedb.p.rapidapi.com/image by default (OSS media ids like EIeI8Vf):
# RAPIDAPI_EXERCISEDB_IMAGE_URL=https://exercisedb.p.rapidapi.com/image
# RAPIDAPI_EXERCISEDB_GIF_RESOLUTION=180
