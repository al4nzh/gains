<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local dev uses HTTP (127.0.0.1, LAN IP, emulator). Prod uses HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
